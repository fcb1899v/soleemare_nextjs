# Copy this file to .env.local and fill in your values.
# Do not commit .env.local or real secrets to the repository.

# ---------------------------------------------------------------------------
# Shopify (required for product/checkout)
# ---------------------------------------------------------------------------
# Store domain only, e.g. your-store.myshopify.com (no https://)
SHOPIFY_STORE_DOMAIN=
# Storefront API access token (Shopify Admin > Apps > Create app > Storefront API)
SHOPIFY_ACCESS_TOKEN=
# Product ID for Sfogliatella (e.g. from Shopify Admin product URL)
SHOPIFY_SFOGLIATELLA_ID=

# ---------------------------------------------------------------------------
# Instagram (required for static export / production)
# ---------------------------------------------------------------------------
# Instagram user ID (Facebook Graph API)
INSTA_ID=
# Facebook Graph API access token
INSTA_TOKEN=

# ---------------------------------------------------------------------------
# Google Analytics
# ---------------------------------------------------------------------------
# Measurement ID (e.g. G-XXXXXXXXXX)
GA_ID=

# ---------------------------------------------------------------------------
# Contact form (Google Forms)
# ---------------------------------------------------------------------------
# Google Form ID from the form URL: .../d/e/FORM_ID/formResponse
GOOGLE_FORM=

# ---------------------------------------------------------------------------
# reCAPTCHA v2 (optional; contact form spam protection)
# ---------------------------------------------------------------------------
# Site key (public) – used by the contact form. If not set, the reCAPTCHA widget is hidden.
# Get both keys at https://www.google.com/recaptcha/admin
RECAPTCHA_V2_SITE_KEY=
# Secret key (private) – for server-side verification only.
RECAPTCHA_V2_SECRET_KEY=

# ---------------------------------------------------------------------------
# Email (optional; only when using /api/sendgrid)
# ---------------------------------------------------------------------------
# SendGrid API key (server-only)
SENDGRID_API_KEY=
